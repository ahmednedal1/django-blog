# Copy this file to .env and replace the placeholder values.
# Generate your own Django secret key before running the project.
SECRET_KEY=replace-with-your-own-secret-key
# Enable debug only for local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Use an existing schema in your PostgreSQL database.
DATABASE_SCHEMA=public
